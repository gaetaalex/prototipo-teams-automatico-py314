# Preencha com os dados fornecidos pela TI e salve uma cópia com o nome .env
TENANT_ID=PREENCHER_COM_A_TI
CLIENT_ID=PREENCHER_COM_A_TI
CLIENT_SECRET=PREENCHER_COM_A_TI

# A TI deve cadastrar exatamente esta URL no aplicativo do Microsoft Entra.
REDIRECT_URI=http://localhost:5056/auth/callback
PORT=5056

# Use uma sequência longa e aleatória em produção.
APP_SECRET=troque-por-uma-chave-aleatoria-longa
